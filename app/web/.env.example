# CMS Backend Configuration
# URL of the Payload CMS API server where this frontend fetches data from.
# When unset/empty, the CMS integration is disabled entirely: no CMS calls are
# made (no timeout wait) and CMS-backed pages render their "unavailable" fallback.
# For local development with the CMS running on port 3000:
#   NUXT_PUBLIC_PAYLOAD_URL=http://localhost:3000/api
# For production: update to your CMS deployment URL.
NUXT_PUBLIC_PAYLOAD_URL=
